# ============================================================================
# 部署环境变量配置示例（Railway / Vercel / Docker）
# ============================================================================
# 说明：将此文件复制为 .env.local 并填写实际值
# 不要提交真实密钥；在部署平台的 Variables 页面配置这些值
# ============================================================================

# ============================================================================
# 1. Supabase 配置（必需）
# ============================================================================
# 从 Supabase Dashboard → Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# 2. AI 服务配置（必需）
# ============================================================================
# 阿里云 DashScope API Key
# 获取地址：https://dashscope.console.aliyun.com/apiKey
ALIBABA_API_KEY=sk-your-alibaba-api-key

# 百度 OCR API Keys
# 获取地址：https://console.bce.baidu.com/ai/#/ai/ocr/app/list
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key

# Google Gemini API Key
# 获取地址：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# DeepSeek（错因分析、文本模式和举一反三使用）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 其他可选 AI Provider
KIMI_API_KEY=sk-your-kimi-api-key
MINIMAX_API_KEY=your-minimax-api-key

# 微信小程序登录；不部署小程序时可不配置
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# ============================================================================
# 3. 可选配置
# ============================================================================
# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 邮件服务（用于通知）
RESEND_API_KEY=re_xxx

# 项目标识
PROJECT_ID=mistake
ENV=production
